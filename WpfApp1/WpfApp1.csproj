    <Resource Include="Assets\gray.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\green.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
