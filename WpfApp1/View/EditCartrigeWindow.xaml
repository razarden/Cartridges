<Window x:Class="WpfApp1.View.EditCartrigeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        ResizeMode="NoResize"
         SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!--Шапка окна-->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0 5 0 5">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/editcartrige.png" HorizontalAlignment="Center"
           Height="30" Margin="20 0 0 0"/>
                <TextBlock Text="Редактирование информации о картридже" Grid.Row="0"
   VerticalAlignment="Center" FontSize="16" FontFamily="Calibri"
   FontWeight="Bold"  
               Margin="20 0 0 0"/>
                
            </StackPanel>
        </Border>

        <!--Модель-->
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Модель" VerticalAlignment="Center" Margin="20 0 0 0"
                       FontSize="14" FontWeight="SemiBold"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Height="30" 
                    Width="270"
                    Margin="90 0 20 0">
                <ComboBox x:Name="Edit_Model"
                        FontSize="14" 
                        BorderBrush="Transparent" 
                        Background="Transparent" 
                        VerticalContentAlignment="Center"
                         IsEditable="True"
                        />
            </Border>
        </StackPanel>

        <!--Серийный номер-->
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="Серийный номер" VerticalAlignment="Center" Margin="20 0 0 0"
               FontSize="14" FontWeight="SemiBold" />
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
            Height="30" 
            Width="270"
            Margin="30 0 0 0">
                <TextBox x:Name="Edit_SerialNumber" Text="dsfdsfdsf" Padding="5 0 "
                FontSize="14" BorderBrush="Transparent" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <!--Принтер-->
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <TextBlock Text="Принтер" VerticalAlignment="Center" Margin="20 0 0 0"
               FontSize="14" FontWeight="SemiBold"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
            Height="30" 
            Width="270"
            Margin="90 0 0 0">
                <ComboBox x:Name="Edit_Printer" 
                         Padding="5 0 "
                         FontSize="15"
                         BorderBrush="Transparent"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         IsEditable="True"
                         DisplayMemberPath="PrinterName"
                         SelectedValuePath="PrinterId"/>
            </Border>
        </StackPanel>
        
        <!--Дата покупки-->
        <StackPanel Orientation="Horizontal" Grid.Row="4">
            <TextBlock Text="Дата покупки" VerticalAlignment="Center" Margin="20 0 0 0"
               FontSize="14" FontWeight="SemiBold"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
            Height="30" 
            Width="270"
            Margin="55 0 0 0">
                <DatePicker x:Name="Edit_DataPurchase" Padding="5 0 " Height="30" 
                FontSize="15" BorderBrush="Transparent" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <!--Статус-->
        <Border Grid.Row="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Статус" VerticalAlignment="Center" Margin="20 0 0 0"
       FontSize="14" FontWeight="SemiBold"/>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Height="30" 
                    Width="270"
                    Margin="105 0 0 0">
                    <ComboBox x:Name="Edit_Status"
                              SelectedIndex="0" 
                              VerticalContentAlignment="Center"
                              >
                        <ComboBoxItem Tag="Новый">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0"/>
                                <TextBlock Text="Новый" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Готов к работе">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#059669" Margin="0,0,10,0"/>
                                <TextBlock Text="Готов к работе" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="В работе">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,10,0"/>
                                <TextBlock Text="В работе" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Пустой"> 
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,10,0"/>
                                <TextBlock Text="Пустой" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="За заправке">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,10,0"/>
                                <TextBlock Text="На заправке" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Списан">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#6B7280" Margin="0,0,10,0"/>
                                <TextBlock Text="Списан" Foreground="Black"/>
                            </StackPanel>
                        </ComboBoxItem>
                        
                    </ComboBox>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" BorderBrush="Gray" 
                BorderThickness="0,1,0,0" Margin="0,5,0,0" 
                Padding="20,15">
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border BorderBrush="Gray" BorderThickness="1" Height="35" 
                Width="100"
                Background="White" 
                CornerRadius="7"
                 Margin="0 0 10 0">
                    <Button Background="Transparent" Content="Отмена" 
                    Foreground="Black"
                    FontWeight="DemiBold"
                    FontSize="14"
                    Click="CancelButton_Click"
                    BorderBrush="Transparent"/>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Height="35" 
            Width="100"
            Background="Blue" 
            CornerRadius="7">
                    <Button Background="Transparent" Content="Сохранить" 
                Foreground="White"
                FontWeight="DemiBold"
                FontSize="14"
                BorderBrush="Transparent"
                Click="SaveChange_Click"/>
                </Border>
            </StackPanel>
        </Border>
         

    </Grid>
</Window>
