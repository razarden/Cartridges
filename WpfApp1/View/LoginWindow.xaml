<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="350">
    <Window.Background>
        <ImageBrush ImageSource="https://cdn.qwenlm.ai/output/62af415f-9d48-45bc-ba60-16ee29360ffe/t2i/a0269622-1256-4ffb-bf57-dbd1d907d27b/1791620055157e.png?key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZXNvdXJjZV91c2VyX2lkIjoiNjJhZjQxNWYtOWQ0OC00NWJjLWJhNjAtMTZlZTI5MzYwZmZlIiwicmVzb3VyY2VfaWQiOiIxNzkxNjIwMDU1MTU3ZSIsInJlc291cmNlX2NoYXRfaWQiOiJjYjgwMzU4Ny1mMjdiLTRmMjktYmY1NC1mZmZmOGJiZjQwMGIifQ.DCJnoluDdwPwi0njE1TLViEWXGFhuQN2azcA4dHyWwg&amp;x-oss-process=image/resize,m_mfit,w_450,h_450"/>
    </Window.Background>
    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Height="550" Width="450">
                <Border Padding="10" Height="300" Width="300">
                    <StackPanel x:Name="registationpanel" Height="300" Width="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Height="40" Text="USER LOGIN" FontSize="20" TextAlignment="Center"
                            Padding="0 5" Background="Gray" Margin="0,0,10,0"/>
                            <Image Grid.Row="1" Source="https://img.icons8.ru/?size=50&amp;id=53388&amp;format=png" 
                               Margin="10,29,256,29"/>
                            <TextBox Grid.Row="1" x:Name="Name" Height="24" Width="220" Text="Your Name" 
                            TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left"
                            VerticalContentAlignment="Center" FontSize="14" Margin="60,0,0,0"
                            BorderBrush="Transparent" Background="Transparent"
                             >
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Rectangle Grid.Row="1" Height="3" Fill="Black" 
                            Margin="0,68,0,21"/>
                            <Image Grid.Row="2" Source="https://img.icons8.ru/?size=50&amp;id=10480&amp;format=png" 
                               Margin="10,28,256,298"
                               />
                            <TextBox Grid.Row="1" x:Name="Role" Height="25" Text="Your Role" 
                            TextAlignment="Left" VerticalAlignment="Top" 
                            VerticalContentAlignment="Center" FontSize="14" 
                            BorderBrush="Transparent"  Margin="60,86,20,0" 
                            Background="Transparent"  
                                   Grid.RowSpan="2">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBox Grid.Row="2" x:Name="password" Height="25" Text="Your Password" 
                             TextAlignment="Left" VerticalAlignment="Top" 
                             VerticalContentAlignment="Center" FontSize="14" 
                             BorderBrush="Transparent"  Margin="60,41,20,0" 
                             Background="Transparent"  >
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Grid>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <Rectangle Grid.Row="2" Height="3" Fill="Black" 
                            Margin="0,24,-10,341"/>
                            <Rectangle Grid.Row="2" Height="3" Fill="Black" 
                            Margin="10,79,-10,286"/>
                            <Button Grid.Row="2" Height="30" Width="120" Margin="0,98,180,240"
                                Content="Register" Background="LightGray" FontWeight="Bold" 
                                 />
                            <Button Grid.Row="2" Height="30" Margin="173,98,20,240"
                                Content="Login" Background="LightGray" FontWeight="Bold"
                                Click="LoginButton_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
